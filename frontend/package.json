{
  "name": "miaoyi-frontend",
  "private": true,
  "version": "1.1.9-cloud",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/sync-vad-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-vad-assets.mjs",
    "build": "tsc && vite build",
    "lint": "eslint src",
    "test": "node ../tests/frontend/run.mjs",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "electron:build": "tsc && vite build && tsc --project tsconfig.electron.json && electron-builder",
    "electron:build:win": "tsc && vite build && tsc --project tsconfig.electron.json && electron-builder --win",
    "electron:build:mac": "tsc && vite build && tsc --project tsconfig.electron.json && electron-builder --mac",
    "electron:build:linux": "tsc && vite build && tsc --project tsconfig.electron.json && electron-builder --linux"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ricky0123/vad-web": "^0.0.17",
    "onnxruntime-web": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.2.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.0",
    "wait-on": "^8.0.5",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.miaoyi.app",
    "productName": "喵艺",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon-512.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon-512.png"
    }
  }
}
