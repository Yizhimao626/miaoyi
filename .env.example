# ============================================================
# 喵艺 · 环境变量示例
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交
# ============================================================
# cp .env.example .env

# ---------- 运行环境 ----------
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001,http://localhost,https://localhost,capacitor://localhost
MAX_BODY_SIZE=6291456

# ---------- LLM API Key（至少配置一个；全部留空则自动进入离线演示模式） ----------
# 智谱 GLM（默认主供应商，同时提供视觉与 embedding）
ZHIPU_API_KEY=
# 深度求索（可作为主回复模型）
DEEPSEEK_API_KEY=
# 阿里云百炼（Qwen 系列，可选；配置后可用于 CosyVoice2 语音）
DASHSCOPE_API_KEY=
# Moonshot Kimi（可选）
MOONSHOT_API_KEY=

# ---------- 离线演示模式 ----------
# 一个 Key 都没配时，后端返回内置示例回复（不联网），便于无 Key 跑通全链路。
# 1=强制启用 / 0=强制关闭；留空则仅在非生产环境（ENVIRONMENT≠production）自动启用
MIAOYI_MOCK_LLM=

# ---------- 安全 ----------
# 必填：下面只是占位值，直接使用等于公开密钥；正式使用务必替换
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
REQUEST_SIGNING_ENABLED=false
REQUEST_TIMESTAMP_TOLERANCE=300
# 注册邀请码（留空表示不校验）
INVITE_CODE=
# 启动时是否清空非管理员数据（开发环境懒人开关，生产务必 false）
CLEAR_NON_ADMIN_ON_STARTUP=false

# ---------- 数据库（默认 SQLite，不需要 MySQL） ----------
# 使用 MySQL 时填写下列变量，并把 config.yaml 的 database.type 改为 mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=miaoyi
MYSQL_PASSWORD=
MYSQL_DATABASE=miaoyi

# ---------- 本地记忆微服务（可选） ----------
MEMORY_TOKEN=change-me
